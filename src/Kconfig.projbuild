menu "Robot Application Mode"

    choice ROBOT_APP_MODE
        prompt "Application mode"
        default ROBOT_APP_MODE_NORMAL

        config ROBOT_APP_MODE_NORMAL
            bool "Normal robot application"

        config ROBOT_APP_MODE_ENCODER_PROBE
            bool "Read-only four-channel encoder probe"

        config ROBOT_APP_MODE_CHASSIS_DIAG
            bool "Default-disarmed chassis diagnostic"

        config ROBOT_APP_MODE_MICROROS_CHASSIS
            bool "Default-disarmed micro-ROS chassis integration"
    endchoice

endmenu

menu "Robot Network Configuration"

    config ROBOT_WIFI_SSID
        string "Wi-Fi SSID"
        default ""

    config ROBOT_WIFI_PASSWORD
        string "Wi-Fi password"
        default ""

    config ROBOT_WIFI_MAXIMUM_RETRY
        int "Maximum retry count"
        range 1 20
        default 10

endmenu
